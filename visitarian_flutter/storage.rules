rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasClaim(name) {
      return signedIn() && request.auth.token[name] == true;
    }

    function hasActiveAdminDoc() {
      return signedIn() &&
          exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
          (
            !(
              get(
                /databases/(default)/documents/admins/$(request.auth.uid)
              ).data.status is string
            ) ||
            get(
              /databases/(default)/documents/admins/$(request.auth.uid)
            ).data.status.lower() == 'active'
          );
    }

    function isContentAdmin() {
      return signedIn() &&
          (
            hasClaim('super_admin') ||
            hasClaim('admin') ||
            hasActiveAdminDoc()
          );
    }

    match /profiles/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isContentAdmin());
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /tours/{tourId}/{allPaths=**} {
      allow read: if true;
      allow write: if isContentAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
