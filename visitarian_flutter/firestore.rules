rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasClaim(name) {
      return signedIn() && request.auth.token[name] == true;
    }

    function authEmail() {
      return request.auth.token.email is string
          ? request.auth.token.email.lower()
          : '';
    }

    function adminDocPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function adminDocExists() {
      return signedIn() && exists(adminDocPath());
    }

    function adminDoc() {
      return get(adminDocPath());
    }

    function userDocExists() {
      return signedIn() && exists(userDocPath());
    }

    function userDoc() {
      return get(userDocPath());
    }

    function adminDocRoleIsSuper() {
      return adminDocExists() &&
          adminDoc().data.role is string &&
          (
            adminDoc().data.role.lower() == 'super_admin' ||
            adminDoc().data.role.lower() == 'superadmin'
          );
    }

    function adminDocIsActive() {
      return adminDocExists() &&
          (
            !(adminDoc().data.status is string) ||
            adminDoc().data.status.lower() == 'active'
          );
    }

    function userRoleIsLegacyAdmin() {
      return userDocExists() &&
          (
            userDoc().data.admin == true ||
            userDoc().data.isAdmin == true ||
            (
              userDoc().data.role is string &&
              (
                userDoc().data.role.lower() == 'admin' ||
                userDoc().data.role.lower() == 'superadmin' ||
                userDoc().data.role.lower() == 'super_admin'
              )
            )
          );
    }

    function isSuperAdmin() {
      return signedIn() &&
          (
            hasClaim('super_admin') ||
            (adminDocRoleIsSuper() && adminDocIsActive())
          );
    }

    function isContentAdmin() {
      return signedIn() &&
          (
            isSuperAdmin() ||
            hasClaim('admin') ||
            adminDocIsActive() ||
            userRoleIsLegacyAdmin()
          );
    }

    match /admins/{userId} {
      allow read: if isSelf(userId) || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /adminInvites/{inviteId} {
      allow read, write: if isSuperAdmin();
    }

    match /accessGrants/{userId} {
      allow read: if isSelf(userId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isContentAdmin();
      allow create, update: if isSelf(userId) &&
          !request.resource.data.keys().hasAny([
            'role',
            'roles',
            'admin',
            'isAdmin',
            'claims',
            'permissions',
            'subscriptionStatus',
            'subscriptionLabel',
            'subscriptionEndsAt',
            'organizationName',
            'managedByUid',
            'managedByEmail'
          ]);
      allow delete: if isSelf(userId);
    }

    match /places/{placeId} {
      allow read: if true;
      allow create, update, delete: if isContentAdmin();
    }

    match /favoriteStats/{placeId} {
      allow read: if true;

      allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['count']) &&
          request.resource.data.count is int &&
          request.resource.data.count == 1;

      allow update: if signedIn() &&
          request.resource.data.keys().hasOnly(['count']) &&
          resource.data.keys().hasOnly(['count']) &&
          resource.data.count is int &&
          request.resource.data.count is int &&
          request.resource.data.count >= 0 &&
          (
            request.resource.data.count == resource.data.count + 1 ||
            request.resource.data.count == resource.data.count - 1
          );

      allow delete: if false;
    }

    match /tours/{tourId} {
      allow read: if true;
      allow create, update, delete: if isContentAdmin();

      match /nodes/{nodeId} {
        allow read: if true;
        allow create, update, delete: if isContentAdmin();
      }
    }

    match /appConfig/{docId} {
      allow read: if true;
      allow create, update, delete: if isContentAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
